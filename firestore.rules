rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHouseholdCode(id) {
      return id is string && id.size() >= 6 && id.size() <= 12 && id.matches('^[A-Z0-9]{6,12}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isHouseholdMember(householdId) {
      return isSignedIn() && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function isHouseholdMemberAfter(householdId) {
      return isSignedIn() && existsAfter(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function isHouseholdOwner(householdId) {
      return isSignedIn() && get(/databases/$(database)/documents/households/$(householdId)).data.ownerId == request.auth.uid;
    }

    function isValidPantryEntry(item) {
      return item is map &&
        item.keys().hasAll(['name', 'quantity']) &&
        item.keys().hasOnly(['name', 'quantity']) &&
        item.name is string && item.name.size() >= 1 && item.name.size() <= 100 &&
        item.quantity is number && item.quantity >= 1 && item.quantity <= 999;
    }

    function isValidPantryList(arr) {
      return arr is list && arr.size() <= 150 && (
        arr.size() == 0 || (
          isValidPantryEntry(arr[0]) &&
          isValidPantryEntry(arr[arr.size() - 1]) &&
          (arr.size() < 2 || isValidPantryEntry(arr[1]))
        )
      );
    }

    function isValidGroceryEntry(item) {
      return item is map &&
        item.keys().hasAll(['id', 'name', 'amount', 'aisle', 'mealTitle', 'completed']) &&
        item.keys().hasOnly(['id', 'name', 'amount', 'aisle', 'mealTitle', 'completed']) &&
        item.id is string && item.id.size() >= 1 && item.id.size() <= 128 &&
        item.name is string && item.name.size() >= 1 && item.name.size() <= 120 &&
        item.amount is string && item.amount.size() <= 60 &&
        item.aisle is string && item.aisle.size() <= 40 &&
        item.mealTitle is string && item.mealTitle.size() <= 120 &&
        item.completed is bool;
    }

    function isValidGroceryList(arr) {
      return arr is list && arr.size() <= 200 && (
        arr.size() == 0 || (
          isValidGroceryEntry(arr[0]) &&
          isValidGroceryEntry(arr[arr.size() - 1]) &&
          (arr.size() < 2 || isValidGroceryEntry(arr[1]))
        )
      );
    }

    function isValidRutEntry(item) {
      return item is map &&
        item.keys().hasAll(['id', 'name', 'dateAdded']) &&
        item.keys().hasOnly(['id', 'name', 'category', 'dateAdded']) &&
        item.id is string && item.id.size() >= 1 && item.id.size() <= 128 &&
        item.name is string && item.name.size() >= 1 && item.name.size() <= 100 &&
        item.dateAdded is string && item.dateAdded.size() <= 64;
    }

    function isValidRutList(arr) {
      return arr is list && arr.size() <= 100 && (
        arr.size() == 0 || (
          isValidRutEntry(arr[0]) &&
          isValidRutEntry(arr[arr.size() - 1]) &&
          (arr.size() < 2 || isValidRutEntry(arr[1]))
        )
      );
    }

    function isValidFavoriteEntry(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function isValidFavoritesList(arr) {
      return arr is list && arr.size() <= 200 && (
        arr.size() == 0 || (
          isValidFavoriteEntry(arr[0]) &&
          isValidFavoriteEntry(arr[arr.size() - 1]) &&
          (arr.size() < 2 || isValidFavoriteEntry(arr[1]))
        )
      );
    }

    function isValidCustomMealEntry(item) {
      return item is map &&
        item.id is string && item.id.size() >= 1 && item.id.size() <= 128 &&
        item.title is string && item.title.size() >= 1 && item.title.size() <= 120 &&
        item.ingredients is list && item.ingredients.size() >= 1 && item.ingredients.size() <= 16 &&
        item.instructions is list && item.instructions.size() >= 1 && item.instructions.size() <= 10;
    }

    function isValidCustomMealsList(arr) {
      return arr is list && arr.size() <= 100 && (
        arr.size() == 0 || (
          isValidCustomMealEntry(arr[0]) &&
          isValidCustomMealEntry(arr[arr.size() - 1]) &&
          (arr.size() < 2 || isValidCustomMealEntry(arr[1]))
        )
      );
    }

    function isValidKitchenProfile(kp) {
      return kp is map &&
        kp.keys().hasAll([
          'environment',
          'equipment',
          'hasFreezer',
          'effort',
          'varietyPreference',
          'dietaryRestrictions'
        ]) &&
        kp.keys().hasOnly([
          'environment',
          'equipment',
          'hasFreezer',
          'effort',
          'varietyPreference',
          'dietaryRestrictions',
          'livingSituation',
          'dormConstraints',
          'sharedKitchen',
          'otherEquipmentLabel'
        ]) &&
        kp.environment is string && kp.environment in ['full_kitchen', 'microwave_only', 'microwave_mini_fridge', 'limited_kitchen', 'custom'] &&
        kp.equipment is list && kp.equipment.size() <= 8 &&
        kp.hasFreezer is bool &&
        kp.effort is string && kp.effort in ['very_low', 'low', 'moderate', 'normal'] &&
        kp.varietyPreference is string && kp.varietyPreference in ['familiar', 'balanced', 'new_ideas'] &&
        kp.dietaryRestrictions is list && kp.dietaryRestrictions.size() <= 4 &&
        (!('livingSituation' in kp) || (kp.livingSituation is string && kp.livingSituation in ['standard', 'dorm'])) &&
        (!('dormConstraints' in kp) || (kp.dormConstraints is map && kp.dormConstraints.keys().size() <= 8)) &&
        (!('sharedKitchen' in kp) || (kp.sharedKitchen is string && kp.sharedKitchen in ['none', 'available_avoid', 'available_use'])) &&
        (!('otherEquipmentLabel' in kp) || (kp.otherEquipmentLabel is string && kp.otherEquipmentLabel.size() <= 60));
    }

    function isValidUserAppState(data) {
      return data.keys().hasAll([
          'ownerId',
          'pantryItems',
          'groceryItems',
          'rutMeals',
          'favorites',
          'customMeals',
          'householdId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'pantryItems',
          'groceryItems',
          'rutMeals',
          'favorites',
          'customMeals',
          'householdId',
          'kitchenProfile',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid &&
        isValidPantryList(data.pantryItems) &&
        isValidGroceryList(data.groceryItems) &&
        isValidRutList(data.rutMeals) &&
        isValidFavoritesList(data.favorites) &&
        isValidCustomMealsList(data.customMeals) &&
        data.householdId is string && data.householdId.size() <= 32 && data.householdId.matches('^$|^[A-Z0-9]{6,12}$') &&
        (!('kitchenProfile' in data) || isValidKitchenProfile(data.kitchenProfile)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidHousehold(data) {
      return data.keys().hasAll(['ownerId', 'name', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'name', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidHouseholdMember(data, memberId) {
      return data.keys().hasAll(['uid', 'role', 'displayName', 'joinedAt']) &&
        data.keys().hasOnly(['uid', 'role', 'displayName', 'joinedAt']) &&
        data.uid is string && isValidId(data.uid) && data.uid == memberId && data.uid == request.auth.uid &&
        data.role is string && data.role.size() <= 16 && (data.role == 'owner' || data.role == 'member') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        data.joinedAt is timestamp;
    }

    function isValidHouseholdSharedState(data) {
      return data.keys().hasAll(['ownerId', 'updatedBy', 'pantryItems', 'groceryItems', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'updatedBy', 'pantryItems', 'groceryItems', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.updatedBy is string && isValidId(data.updatedBy) && data.updatedBy == request.auth.uid &&
        isValidPantryList(data.pantryItems) &&
        isValidGroceryList(data.groceryItems) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Private per-user meal planner state
    match /users/{userId}/appState/{stateId} {
      allow get: if isValidId(userId) && stateId == 'main' && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        stateId == 'main' &&
        isOwner(userId) &&
        isValidUserAppState(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        stateId == 'main' &&
        isValidUserAppState(incoming()) &&
        isOwner(userId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly(['pantryItems', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['groceryItems', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['rutMeals', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['favorites', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['customMeals', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['householdId', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['kitchenProfile', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['pantryItems', 'groceryItems', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['pantryItems', 'groceryItems', 'householdId', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['pantryItems', 'groceryItems', 'rutMeals', 'favorites', 'customMeals', 'householdId', 'kitchenProfile', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['pantryItems', 'groceryItems', 'rutMeals', 'favorites', 'customMeals', 'householdId', 'updatedAt'])
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && stateId == 'main' && isOwner(userId);
    }

    // Optional shared household
    match /households/{householdId} {
      allow get: if isValidHouseholdCode(householdId) && isHouseholdMember(householdId);
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidHouseholdCode(householdId) &&
        isValidHousehold(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidHouseholdCode(householdId) &&
        isValidHousehold(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']);
      allow delete: if isVerifiedUser() &&
        isValidHouseholdCode(householdId) &&
        existing().ownerId == request.auth.uid;

      match /members/{memberId} {
        allow get: if isValidHouseholdCode(householdId) &&
          isValidId(memberId) &&
          isSignedIn() && (
            request.auth.uid == memberId ||
            isHouseholdMember(householdId)
          );
        allow list: if false;
        allow create: if isVerifiedUser() &&
          isValidHouseholdCode(householdId) &&
          isValidId(memberId) &&
          isValidHouseholdMember(incoming(), memberId) &&
          incoming().joinedAt == request.time && (
            (incoming().role == 'owner' &&
              getAfter(/databases/$(database)/documents/households/$(householdId)).data.ownerId == request.auth.uid) ||
            (incoming().role == 'member' &&
              exists(/databases/$(database)/documents/households/$(householdId)))
          );
        allow update: if false;
        allow delete: if isVerifiedUser() &&
          isValidHouseholdCode(householdId) &&
          isValidId(memberId) && (
            request.auth.uid == memberId ||
            isHouseholdOwner(householdId)
          );
      }

      match /sharedState/{stateId} {
        allow get: if isValidHouseholdCode(householdId) && stateId == 'main' && isHouseholdMember(householdId);
        allow list: if false;
        allow create: if isVerifiedUser() &&
          isValidHouseholdCode(householdId) &&
          stateId == 'main' &&
          isValidHouseholdSharedState(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time && (
            isHouseholdMemberAfter(householdId) ||
            isHouseholdMember(householdId)
          );
        allow update: if isVerifiedUser() &&
          isValidHouseholdCode(householdId) &&
          stateId == 'main' &&
          isValidHouseholdSharedState(incoming()) &&
          isHouseholdMember(householdId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            incoming().diff(existing()).affectedKeys().hasOnly(['pantryItems', 'updatedBy', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['groceryItems', 'updatedBy', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['pantryItems', 'groceryItems', 'updatedBy', 'updatedAt'])
          );
        allow delete: if isVerifiedUser() &&
          isValidHouseholdCode(householdId) &&
          stateId == 'main' &&
          isHouseholdOwner(householdId);
      }
    }
  }
}
