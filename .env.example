# GEMINI_API_KEY: Required for AI meal generation (Gemini API, free tier).
# Get a free key at https://aistudio.google.com/apikey. Copy this file to .env for local dev.
# In Firebase App Hosting it is stored as a Cloud Secret Manager secret (see apphosting.yaml).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: override the Gemini model (default: gemini-3.1-flash-lite).
# GEMINI_MODEL="gemini-3.1-flash-lite"
