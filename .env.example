# ANTHROPIC_API_KEY: Required for AI meal generation (Claude API).
# Get one at https://console.anthropic.com. Copy this file to .env for local dev.
# In Firebase App Hosting it is stored as a Cloud Secret Manager secret (see apphosting.yaml).
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# Optional: override the Claude model (default: claude-haiku-5-5).
# CLAUDE_MODEL="claude-haiku-5-5"

# Optional: per-request generation timeout in ms (default: 45000).
# GENERATION_TIMEOUT_MS="45000"
